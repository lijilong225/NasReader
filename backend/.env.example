# 复制为 .env 后填写真实值：cp .env.example .env
# docker compose 会自动读取同目录的 .env

# 必填，至少 32 字节；生成方式: openssl rand -base64 48
# 缺失或过短时服务拒绝启动；轮换后所有设备需重新登录
JWT_SECRET=

# 可选，仅浏览器端跨域访问时需要
# 逗号分隔的完整来源（含协议与端口），不支持通配符，末尾不加 /
CORS_ALLOWED_ORIGINS=

# 可选，注册邀请码；留空则注册接口直接返回 403
# 建议 8 字节以上随机值，生成方式: openssl rand -hex 12
REGISTRATION_INVITE_CODE=
